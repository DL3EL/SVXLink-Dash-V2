    "#CD2626",       // 05 - Feuer Rot
    "#CD0000",       // 06 - Dunkles Rot
    "#f4511e",       // 07 - Rotorange
    "#EEB422",       // 08 - Gold
    "#006400",       // 09 - Dunkelgrün
    "#8B636C",       // 10 - Pink
    "#5C5C5C",       // 11 - Grau
    "#CD5555"        // 12 - Inian Rot
];

