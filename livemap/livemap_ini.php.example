// ------------------------------------------------------------
// Empfänger
// ------------------------------------------------------------
// Farbe der grünen Empfänger-Marker auf der Karte.
$LIVEMAP_RECEIVER_COLOR = "#3cb371"; 		//grün



// ============================================================
// 2. FARBPALETTE DER TG-VERBINDUNGSLINIEN
// ============================================================
//
// Die TGs werden automatisch einer Farbe aus dieser Palette
// zugeordnet.
//
// Die Reihenfolge der Farben bleibt dabei wichtig.
// Es müssen keine TG-Nummern eingetragen werden.
//
// Wenn eine Farbe geändert wird, ändern sich automatisch die
// Linien derjenigen TGs, die dieser Farbposition zugeordnet
// sind.
//
// Es können auch eigene HEX-Farben verwendet werden.
//
// Beispiel:
//     "#ffff00" = Gelb
//     "#00ffff" = Cyan
//     "#ff00ff" = Magenta
// ============================================================

$LIVEMAP_COLORS = [
